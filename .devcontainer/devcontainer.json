{
  "name": "Embedded Linux C++",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "ubuntu",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cpptools",
        "editorconfig.editorconfig"
      ],
      "settings": {
        // clangd provides IntelliSense; cpptools is only used for gdb debugging
        "C_Cpp.intelliSenseEngine": "disabled",
        // Copy the active preset's compile database to the root, where clangd looks for it
        "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json"
      }
    }
  }
}
